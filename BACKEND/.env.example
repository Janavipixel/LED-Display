# SIES GST CSE-IoT LED Display Management System
# Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/sies_gst_led
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/sies_gst_led?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sies_gst_led

# JWT Secret for Admin Authentication (use a strong random string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=24h

# Default Seed Administrator Credentials (auto-seeded on first run if no admin exists)
ADMIN_EMAIL=admin@sies.edu.in
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=SIES GST IoT Admin

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGIN=*

# Hardware API Security (optional secret token header for ESP32)
# If set, ESP32 must provide header: x-hardware-token: <HARDWARE_API_KEY>
HARDWARE_API_KEY=your_hardware_api_key_here
